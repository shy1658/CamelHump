{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "OpenHarmony",
        "material": {
          "storeFile": "./keystore/camelhump.p12",
          "storePassword": "CamelHump2026DebugSigningStorePwd73X",
          "keyAlias": "camelhump-app-v1",
          "keyPassword": "CamelHump2026DebugSigningKeyStorePwd3Y",
          "signAlg": "SHA256withECDSA",
          "profile": "./keystore/camelhump.p7b",
          "certpath": "./keystore/app-cert.cer"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.1.0(18)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
