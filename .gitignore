# DevEco Studio / hvigor
/node_modules
/oh_modules
/.hvigor
/.idea
/build
/entry/build
/local.properties
/.cxx
*.har
*.hap
*.hsp

# llama.cpp is pulled in as a submodule; never commit its build output
/entry/src/main/cpp/third_party/llama.cpp/build*
/entry/src/main/cpp/third_party/llama.cpp/*.gguf

# Model weights never belong in git
*.gguf
*.safetensors
*.bin
/models/*.gguf

# self-test build artifacts
/tools/gguf-selftest/fixtures
/tools/gguf-selftest/inspector

# CMake 配置缓存(含 llama.cpp 目标文件, 上百 MB)
**/.cxx

# llama.cpp 源码(181MB)不进仓库, 用 tools/fetch-llama.sh 拉取
/entry/src/main/cpp/third_party/llama.cpp/

# 签名私钥不入库(cert/p7b 是公开产物, p12 是私钥)
/keystore/*.p12

# 软著材料：PDF 由脚本生成，不入库（体积大且可复现）
# 需要时执行 tools/gen-copyright-source.py 与 tools/gen-copyright-manual.py 重建
/docs/copyright/*.pdf
/docs/copyright/*.html
/docs/copyright/源代码-纯文本备份.txt

# 发布证书的私钥与 CSR（申请发布证书用的本地材料，不入库）
# .cer 与 .p7b 是华为签发的公开产物，可入库；.p12 是私钥，绝不能入库
/keystore/release.p12
/keystore/release.csr

# hvigor 的签名加密材料（命令行工具链自带的公开材料，可入库，
# 便于纯命令行环境构建；不含任何私钥信息）
# keystore/material/  ← 不忽略

# 上架用的 .app 包（含发布签名，2.6MB）
# 由 tools/build-app.sh 生成，不入库
/CamelHump-release.app
